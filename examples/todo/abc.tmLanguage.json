{
    "comment": "https://code.visualstudio.com/api/language-extensions/syntax-highlight-guide", 
    "fileTypes": [ "abc" ],
    "scopeName": "source.abc",
    "patterns": [{"include": "#expression"}],
    "repository": { 
        "expression": {
            "patterns": [{"include": "#letter"}, {"include": "#paren"}]
        },
        "letter": {
            "match": "a|b|c",
            "name": "keyword.letter"
        },
        "paren": {
            "begin": "\\(|\\[",
            "end": "\\)|\\]",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.paren.open"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.paren.close"
                }
            },
            "name": "expression.group"
        }
    }
}